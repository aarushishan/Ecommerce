# ==============================================================================
# ShopSphere Environment Variables Configuration (.env.example)
# Duplicate this file to .env and adjust variables as needed.
# ==============================================================================

# Application Environment & Server
ENVIRONMENT=development
DEBUG=True
APP_NAME=ShopSphere
APP_VERSION=1.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-super-secret-random-32-character-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_USER=shopsphere_user
POSTGRES_PASSWORD=shopsphere_password
POSTGRES_DB=shopsphere_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://shopsphere_user:shopsphere_password@localhost:5432/shopsphere_db

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Payment Gateway Configuration (Test Mode & Mock)
PAYMENT_PROVIDER=MOCK
STRIPE_PUBLIC_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample
RAZORPAY_KEY_ID=rzp_test_sample
RAZORPAY_KEY_SECRET=sample_secret

# Media & Storage (Cloudinary / Local Fallback)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI & LLM Services (Optional / Fallback provided)
AI_MODEL_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
